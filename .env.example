GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# 보고서 합성 전용 모델. 비우면 GEMINI_MODEL을 그대로 쓴다.
# GEMINI_MODEL을 바꾸면 추출 캐시(model_ver)가 통째로 무효화되지만, 이 값은 캐시 키에
# 들어가지 않아 재추출 없이 보고서 품질만 바꿔 볼 수 있다.
GEMINI_MODEL_REDUCE=
THINKING_MAP=low
THINKING_REDUCE=high
# reduce 출력 상한(thinking 토큰 포함). 서술형 심층 보고서를 요구하므로 넉넉하게 잡는다.
GEMINI_MAX_OUTPUT_TOKENS=16000

OPENALEX_API_KEY=
OPENALEX_PER_PAGE=100
OPENALEX_DAILY_BUDGET_USD=0.5
OPENALEX_SEARCH_COST_USD=0.001
KCI_API_KEY=
KCI_PAGE_SIZE=100
KCI_MAX_PAGES=20

# OpenAlex 결측 초록을 ScienceDirect Article Retrieval로 회수한다(무료 등록 키로 동작,
# 실측 회수율 88%). 비어 있으면 회수 단계를 통째로 건너뛴다 — 키 없이도 기존 동작 그대로.
# dev.elsevier.com에서 발급. 회수한 초록은 map 단계에서 Gemini로 전송되므로 API
# 이용약관상 외부 전송이 허용되는지 확인 후 채울 것.
ELSEVIER_API_KEY=
# 실측: 동시성 3에서 9.5 req/s(429 없음), 5에서 429 발생. 문서상 한도 10 req/s.
ELSEVIER_CONCURRENCY=3

# 관리자 API 전체(과금 실행·분석 삭제·스케줄 변경)를 여는 유일한 자격증명이다.
# 계정도 시도 횟수 제한도 없으므로 **길이가 곧 방어선**이다 — 32자 이상 난수를 쓴다:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_KEY=
# DB 자격증명. compose가 이 값을 쓰지 않고 아래 POSTGRES_PASSWORD로 초기화하므로
# 둘의 비밀번호는 같아야 한다.
DATABASE_URL=postgresql://perfrev:perfrev@db:5432/perfrev
# 비우면 compose가 기본값(perfrev)으로 DB를 만든다. 포트는 127.0.0.1에만 바인딩되지만
# 호스트 안의 다른 프로세스에는 그대로 열려 있으니 운영에서는 채운다.
# **초기화(initdb) 때 한 번만 적용된다** — 이미 만들어진 pgdata 볼륨에는 반영되지 않으니
# 나중에 바꾸려면 `docker compose exec db psql -U perfrev -c "ALTER USER perfrev PASSWORD '...'"`를
# 함께 실행하고 DATABASE_URL도 같이 고친다.
POSTGRES_PASSWORD=

BATCH_MAX_ENQUEUED_TOKENS=5000000
BATCH_MAX_CONCURRENT_JOBS=2
BATCH_MAX_REQUESTS_PER_FILE=1000
SYNC_RPM=60

# Gemini batch(map) 단가 — ai.google.dev/gemini-api/docs/pricing 의
# gemini-3.1-flash-lite batch(표준 $0.25/$1.50의 50%). 2026-08-25 가격표로 확인.
# 출력 단가는 thinking 토큰 포함 기준 — 여기가 비용의 70%다(아래 실측 참고).
# **이 값을 낮춰 적어 두면 비용을 그만큼 과소평가한다.** 실제로 운영 .env에
# 0.0375/0.15(4.3배 낮은 값)가 들어가 있었다.
GEMINI_BATCH_INPUT_USD_PER_1M=0.125
GEMINI_BATCH_OUTPUT_USD_PER_1M=0.75
# 미리보기용 논문당 평균 토큰 근사치(실제 논문 본문을 모를 때 사용).
# 2026-08-25 실측(count_tokens + usage_metadata, 무작위 표본): 논문 본문
# (제목+초록) 345토큰, 요청 전체 입력 952토큰, 출력 365토큰(가시 253 + thinking 112,
# THINKING_MAP=low 기준). 입력값이 500인 것은 estimate_llm_cost_usd가
# _INSTRUCTION_TOKENS(근사식으로 451)를 따로 더하기 때문이다 — 451+500≈952로 맞춘 값이라
# "논문 본문만의 토큰 수"(345)가 아니다. MAP_INSTRUCTION을 고치면 다시 맞출 것.
GEMINI_AVG_INPUT_TOKENS_PER_PAPER=500
GEMINI_AVG_OUTPUT_TOKENS_PER_PAPER=365

MAX_PAPERS_PER_ANALYSIS=5000
MAX_EXTRACT_ATTEMPTS=3
MAX_SEARCH_ATTEMPTS=3
REDUCE_GROUP_THRESHOLD=500
DEFAULT_YEAR_RANGE=3
LOOP_INTERVAL_SECONDS=30

# 월간 자동 분석 스케줄러. 매월 SCHEDULE_DAY일 SCHEDULE_HOUR시대(SCHEDULE_TIMEZONE 기준)에
# 활성 세부기술 전부를 당해연도~(당해-SCHEDULE_YEARS_BACK)연도로 큐잉한다.
# 1~3일은 다른 서비스가 같은 OpenAlex 키를 쓰므로 겹치지 않게 10일로 피했다.
#
# ENABLED/DAY/HOUR/YEARS_BACK은 DB(schedule_settings, 싱글턴 행)가 비어 있을 때 딱 한 번
# seed되는 초기 기본값일 뿐이다 — 실제 값은 관리자 화면("자동 분석 스케줄" 카드)에서
# 재기동 없이 바꾼다. TIMEZONE만 예외로 .env 전용이며 화면에는 읽기 전용으로 표시된다.
SCHEDULE_ENABLED=true
SCHEDULE_DAY=10
SCHEDULE_HOUR=3
SCHEDULE_TIMEZONE=Asia/Seoul
SCHEDULE_YEARS_BACK=1

HTTP_MAX_ATTEMPTS=5
HTTP_TIMEOUT_SECONDS=60
# 429의 Retry-After가 이 값을 넘으면 기다리지 않고 크레딧 소진으로 처리해 잡을
# paused로 내린다(자정에 자동 재개). 잡 루프가 순차 처리라 긴 대기는 서비스 전체를
# 멈춘다 — 실측으로 OpenAlex가 43,579초를 요구해 재추출 110건이 정지했다.
HTTP_MAX_RETRY_AFTER_SECONDS=300

API_PORT=8003
WEB_PORT=8103
DB_PORT=5403

# 쉼표 구분 허용 오리진 목록. 관리자 인증이 정적 헤더 하나뿐이므로 "*"로 두지 말 것.
CORS_ORIGINS=http://localhost:8103

# 푸터에 표시할 도메인명. 비워두면 프론트가 window.location.host로 대체한다.
SITE_DOMAIN=
# 방문자 식별 해시(IP+UA+날짜)에 쓰는 솔트. 운영 배포 시 반드시 임의의 긴 문자열로 바꿀 것.
VISITOR_SALT=change-me-in-prod
