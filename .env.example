GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
THINKING_MAP=low
THINKING_REDUCE=high

OPENALEX_API_KEY=
OPENALEX_PER_PAGE=100
OPENALEX_DAILY_BUDGET_USD=0.5
OPENALEX_SEARCH_COST_USD=0.001
KCI_API_KEY=
KCI_PAGE_SIZE=100
KCI_MAX_PAGES=20

ADMIN_KEY=
DATABASE_URL=postgresql://perfrev:perfrev@db:5432/perfrev

BATCH_MAX_ENQUEUED_TOKENS=5000000
BATCH_MAX_CONCURRENT_JOBS=2
BATCH_MAX_REQUESTS_PER_FILE=1000
SYNC_RPM=60

# Gemini batch(map) 단가. 정확한 단가는 확인되지 않았다 — 같은 세대 flash-lite 계열의
# 공개 단가를 보수적으로 반영한 추정치다. 확인되는 대로 조정할 것.
# ai.google.dev/gemini-api/docs/pricing — gemini-3.1-flash-lite batch(표준가의 50%)
# 출력 단가는 thinking 토큰 포함 기준
GEMINI_BATCH_INPUT_USD_PER_1M=0.125
GEMINI_BATCH_OUTPUT_USD_PER_1M=0.75
# 미리보기용 논문당 평균 토큰 근사치(실제 논문 본문을 모를 때 사용).
GEMINI_AVG_INPUT_TOKENS_PER_PAPER=700
GEMINI_AVG_OUTPUT_TOKENS_PER_PAPER=200

MAX_PAPERS_PER_ANALYSIS=5000
MAX_EXTRACT_ATTEMPTS=3
MAX_SEARCH_ATTEMPTS=3
REDUCE_GROUP_THRESHOLD=500
DEFAULT_YEAR_RANGE=3
LOOP_INTERVAL_SECONDS=30

HTTP_MAX_ATTEMPTS=5
HTTP_TIMEOUT_SECONDS=60

API_PORT=8003
WEB_PORT=8103
DB_PORT=5403

# 쉼표 구분 허용 오리진 목록. 관리자 인증이 정적 헤더 하나뿐이므로 "*"로 두지 말 것.
CORS_ORIGINS=http://localhost:8103

# 푸터에 표시할 도메인명. 비워두면 프론트가 window.location.host로 대체한다.
SITE_DOMAIN=
# 방문자 식별 해시(IP+UA+날짜)에 쓰는 솔트. 운영 배포 시 반드시 임의의 긴 문자열로 바꿀 것.
VISITOR_SALT=change-me-in-prod
